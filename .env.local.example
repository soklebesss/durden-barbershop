# Supabase — copy to .env.local and fill from your project's API settings.
# Project → Settings → API. The anon key is safe in the browser: writes are
# gated by RLS + the SECURITY DEFINER book_appointment() RPC.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
